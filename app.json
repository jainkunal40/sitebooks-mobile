{
  "expo": {
    "name": "SiteBooks",
    "slug": "sitebooks",
    "version": "1.0.0",
    "scheme": "sitebooks",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exploreinteriors.sitebooks"
    },
    "android": {
      "package": "com.exploreinteriors.sitebooks",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SiteBooks uses the camera to scan a client's pairing QR code."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
